# SuspectingWAF Configuration
# Copy this file to .env and change the values

# Management dashboard port
MGT_PORT=9443

# Proxy listen port (HTTP)
PROXY_PORT=80

# Proxy listen port (HTTPS)
PROXY_SSL_PORT=443

# JWT secret for dashboard auth (change this!)
JWT_SECRET=change-me-to-something-random-and-long

# Default admin credentials (only used on first run)
ADMIN_USER=admin
ADMIN_PASS=suspecting123

# Database path
DB_PATH=./data/suspecting.db

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Data directory
DATA_DIR=./data

# WAF mode: block, monitor, off
WAF_MODE=block
